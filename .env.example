# Copy to .env.local and fill in. Never commit real values.

# Required for the career chat (server-side only).
OPENAI_API_KEY=

# Optional UTC cutoff after which the app stops calling OpenAI (ISO 8601).
OPEN_AI_EXPIRATION=2026-12-07T00:00:00Z

# Optional model override (defaults to gpt-4.1-mini).
CAREER_MODEL=

# Optional global cap on chat requests per UTC day (defaults to 200).
CHAT_DAILY_REQUEST_LIMIT=200

# Header your hosting platform sets with the real client IP, e.g. cf-connecting-ip
# or x-real-ip. Leave empty locally: all visitors then share one rate-limit bucket.
CHAT_CLIENT_IP_HEADER=

# Secret for signing chat replies. Required when running more than one server
# instance; generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CHAT_SIGNING_SECRET=

# Public origin, used for canonical URLs, Open Graph and the sitemap.
SITE_URL=
